{"elements": [{"elem_type": "Button", "x": 13.0, "y": 364, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "+/-", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 1}, {"elem_type": "Button", "x": 102.0, "y": 364, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 0, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 2}, {"elem_type": "Button", "x": 192.0, "y": 364, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "\u25fe", "font": ["Segoe UI", 14], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 3}, {"elem_type": "Button", "x": 282.0, "y": 364, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "=", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#f85cf8", "command": "", "corner_radius": "", "border_width": 4, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 4}, {"elem_type": "Button", "x": 13.0, "y": 314, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 1, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 5}, {"elem_type": "Button", "x": 102.0, "y": 314, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 2, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 6}, {"elem_type": "Button", "x": 192.0, "y": 314, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 3, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 7}, {"elem_type": "Button", "x": 282.0, "y": 314, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "+", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 8}, {"elem_type": "Button", "x": 13.0, "y": 264, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 4, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 9}, {"elem_type": "Button", "x": 102.0, "y": 264, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 5, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 10}, {"elem_type": "Button", "x": 192.0, "y": 264, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 6, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 11}, {"elem_type": "Button", "x": 282.0, "y": 264, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "-", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 12}, {"elem_type": "Button", "x": 13.0, "y": 214, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 7, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 13}, {"elem_type": "Button", "x": 102.0, "y": 214, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 8, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 14}, {"elem_type": "Button", "x": 192.0, "y": 214, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": 9, "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 15}, {"elem_type": "Button", "x": 282.0, "y": 214, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "X", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 16}, {"elem_type": "Button", "x": 13.0, "y": 164, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "C", "font": ["Segoe UI", 18], "fg": "#a8ffd3", "bg": "#0b335b", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 17}, {"elem_type": "Button", "x": 102.0, "y": 164, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "CE", "font": ["Segoe UI", 18], "fg": "#ffff00", "bg": "#13599f", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 18}, {"elem_type": "Button", "x": 192.0, "y": 164, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "<-", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 19}, {"elem_type": "Button", "x": 282.0, "y": 164, "canvas_w": 84.0, "canvas_h": 45.0, "props": {"text": "/", "font": ["Segoe UI", 18], "fg": "#FFFFFF", "bg": "#5ea5ec", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 20}, {"elem_type": "Label", "x": 12.0, "y": 64, "canvas_w": 353.0, "canvas_h": 95.0, "props": {"text": "", "font": ["Segoe UI", 24], "fg": "#f5f5f5", "bg": "#2c2c2c", "relief": "sunken", "justify": "center", "corner_radius": "", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 21}, {"elem_type": "Label", "x": 12.0, "y": 6, "canvas_w": 353.0, "canvas_h": 30.0, "props": {"text": "CALCULATOR LATEST", "font": ["Segoe UI Black", 16], "fg": "#0b335b", "bg": "#c6e3f9", "relief": "flat", "justify": "left", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 22}, {"elem_type": "Label", "x": 12.0, "y": 35, "canvas_w": 353.0, "canvas_h": 30.0, "props": {"text": "", "font": ["Segoe UI Semibold", 11], "fg": "#0b335b", "bg": "#c6e3f9", "relief": "flat", "justify": "right", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": null, "parent_tab": null, "elem_id": 23}, {"elem_type": "LEDIndicator", "x": 341, "y": 137, "canvas_w": 15.0, "canvas_h": 15.0, "props": {"state": "Off", "on_color": "#00FF66", "off_color": "#16351F", "shape": "Round", "brightness": 100, "glow": "Yes", "border_width": 1, "bg": "#2c2c2c", "source_widget": "17", "source_mode": "Toggle", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": null, "parent_tab": null, "elem_id": 24}, {"elem_type": "StatusBar", "x": 0, "y": 421.0, "canvas_w": 380.0, "canvas_h": 24.0, "props": {"text": "Ready", "font": ["Segoe UI", 9], "fg": "#ffffff", "bg": "#1563b0", "relief": "sunken", "anchor": "w", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": null, "parent_tab": null, "elem_id": 25}, {"elem_type": "LinkLabel", "x": 253, "y": 423.0, "canvas_w": 120.0, "canvas_h": 20.0, "props": {"text": "Guilbuilder on Github", "font": ["Segoe UI", 9, "underline"], "fg": "#ff80ff", "bg": "#1563b0", "cursor": "hand2", "url": "https://github.com/rahilkasimi/guibuilder", "corner_radius": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": null, "parent_tab": null, "elem_id": 26}], "next_id": 27, "reusable_ids": [], "window_title": "Calculator Latest", "canvas_w": 380.0, "canvas_h": 445.0, "canvas_bg": "#1563b0", "canvas_bg_image": "", "canvas_bg_image_mode": "Fit", "canvas_bg_image_anchor": "Center", "window_state": "Centered", "window_locked": true, "canvas_imports": "import tkinter as tk\nfrom tkinter import ttk", "user_code": "\"\"\"\nMainApplication -- Background Logic & Keyboard Bindings Implementation\n\"\"\"\n\nfrom main_app_designer import _MainApplicationDesigner\nfrom time import strftime\n\nclass MainApplication(_MainApplicationDesigner):\n    def __init__(self, root):\n        self.root = root\n        self._build_ui()\n        \n        # Calculator state variables\n        self.expression = \"\"\n        self.should_reset = False\n        self._update_display(\"0\")\n        \n        # Clock & Keyboard bindings setup\n        self._update_clock()\n        self._bind_keyboard_events()\n\n    def _bind_keyboard_events(self):\n        \"\"\"Binds window keypress events to handler.\"\"\"\n        self.root.bind(\"<Key>\", self._handle_keypress)\n\n    def _handle_keypress(self, event):\n        \"\"\"Routes key events to corresponding application methods.\"\"\"\n        char = event.char\n        keysym = event.keysym\n\n        if char in \"0123456789\":\n            self._append_char(char)\n        elif char == \".\":\n            self._on_Button_3()\n        elif char == \"+\":\n            self._append_operator(\"+\")\n        elif char == \"-\":\n            self._append_operator(\"-\")\n        elif char in (\"*\", \"x\", \"X\"):\n            self._append_operator(\"X\")\n        elif char == \"/\":\n            self._append_operator(\"/\")\n        elif keysym in (\"Return\", \"KP_Enter\") or char == \"=\":\n            self._on_Button_4()\n        elif keysym == \"BackSpace\":\n            self._on_Button_19()\n        elif keysym == \"Escape\" or char.lower() == \"c\":\n            self._on_Button_17()\n        elif keysym == \"Delete\":\n            self._on_Button_18()\n\n    def _update_display(self, text):\n        \"\"\"Helper method to refresh display label _elem_21.\"\"\"\n        self._elem_21.config(text=text if text else \"0\")\n\n    def _append_char(self, char):\n        \"\"\"Appends digit to expression.\"\"\"\n        if self.should_reset:\n            self.expression = \"\"\n            self.should_reset = False\n        self.expression += str(char)\n        self._update_display(self.expression)\n\n    def _append_operator(self, op):\n        \"\"\"Appends operator with formatting.\"\"\"\n        if self.should_reset:\n            self.should_reset = False\n            \n        if not self.expression:\n            if op == \"-\":\n                self.expression = \"-\"\n                self._update_display(self.expression)\n            return\n\n        # Overwrite previous operator if clicked consecutively\n        if self.expression.endswith((\" + \", \" - \", \" X \", \" / \")):\n            self.expression = self.expression[:-3] + f\" {op} \"\n        else:\n            self.expression += f\" {op} \"\n            \n        self._update_display(self.expression)\n\n    # --- Button Event Handlers ---\n\n    def _on_Button_1(self, event=None):\n        \"\"\"+/- (Toggle Sign)\"\"\"\n        if not self.expression or self.expression == \"0\":\n            return\n        parts = self.expression.rsplit(\" \", 1)\n        last_part = parts[-1]\n        if last_part:\n            if last_part.startswith(\"-\"):\n                last_part = last_part[1:]\n            else:\n                last_part = \"-\" + last_part\n            parts[-1] = last_part\n            self.expression = \" \".join(parts)\n            self._update_display(self.expression)\n\n    def _on_Button_2(self, event=None): self._append_char(\"0\")\n    def _on_Button_3(self, event=None):\n        parts = self.expression.rsplit(\" \", 1)\n        if \".\" not in parts[-1]:\n            self._append_char(\".\")\n\n    def _on_Button_4(self, event=None):  # =\n        if not self.expression:\n            return\n        try:\n            calc_expr = self.expression.replace(\"X\", \"*\")\n            result = eval(calc_expr)\n            \n            if isinstance(result, float) and result.is_integer():\n                result = int(result)\n            elif isinstance(result, float):\n                result = round(result, 8)\n\n            self.expression = str(result)\n            self._update_display(self.expression)\n            self.should_reset = True\n            # self._elem_24.set_state(False)\n            \n        except ZeroDivisionError:\n            self._update_display(\"Error: Div by 0\")\n            self.expression = \"\"\n            self.should_reset = True\n        except Exception:\n            self._update_display(\"Error\")\n            self.expression = \"\"\n            self.should_reset = True\n\n    def _on_Button_5(self, event=None): self._append_char(\"1\")\n    def _on_Button_6(self, event=None): self._append_char(\"2\")\n    def _on_Button_7(self, event=None): self._append_char(\"3\")\n    def _on_Button_8(self, event=None): self._append_operator(\"+\")\n    def _on_Button_9(self, event=None): self._append_char(\"4\")\n    def _on_Button_10(self, event=None): self._append_char(\"5\")\n    def _on_Button_11(self, event=None): self._append_char(\"6\")\n    def _on_Button_12(self, event=None): self._append_operator(\"-\")\n    def _on_Button_13(self, event=None): self._append_char(\"7\")\n    def _on_Button_14(self, event=None): self._append_char(\"8\")\n    def _on_Button_15(self, event=None): self._append_char(\"9\")\n    def _on_Button_16(self, event=None): self._append_operator(\"X\")\n\n    def _on_Button_17(self, event=None):\n        \"\"\"C (Clear All)\"\"\"\n        self.expression = \"\"\n        self.should_reset = False\n        self._update_display(\"0\")\n\n    def _on_Button_18(self, event=None):\n        \"\"\"CE (Clear Entry)\"\"\"\n        if \" \" in self.expression:\n            self.expression = self.expression.rsplit(\" \", 1)[0] + \" \"\n        else:\n            self.expression = \"\"\n        self._update_display(self.expression if self.expression.strip() else \"0\")\n\n    def _on_Button_19(self, event=None):\n        \"\"\"<- (Backspace)\"\"\"\n        if self.expression.endswith(\" \"):\n            self.expression = self.expression[:-3]\n        else:\n            self.expression = self.expression[:-1]\n        self._update_display(self.expression if self.expression else \"0\")\n\n    def _on_Button_20(self, event=None): self._append_operator(\"/\")\n\n    # Stubs for static design elements\n    def _on_Button_21(self, event=None): pass\n    def _on_Button_22(self, event=None): pass\n    def _on_Button_23(self, event=None): pass\n    def _on_Button_24(self, event=None): pass\n\n    def _update_clock(self):\n        \"\"\"Updates self._elem_23 with current date and time every second.\"\"\"\n        now = strftime(\"%d-%m-%Y  %H:%M:%S\")\n        self._elem_23.config(text=now)\n        self.root.after(1000, self._update_clock)\n\n    def _on_LinkLabel_26(self, event=None):\n        \"\"\"\n        Event handler for LinkLabel (ID: 26).\n        Triggered by: <Button-1>\n        Access widget instance via: self._elem_26\n        \"\"\"\n        pass\nif __name__ == '__main__':\n    import tkinter as tk\n    root = tk.Tk()\n    app = MainApplication(root)\n    root.mainloop()"}