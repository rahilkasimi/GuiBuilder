{"elements": [{"elem_type": "Button", "x": 100.0, "y": 248.0, "canvas_w": 100.0, "canvas_h": 41.0, "props": {"text": "Login", "font": ["Segoe UI", 11], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 7, "parent_tab": null, "elem_id": 1}, {"elem_type": "Label", "x": 40.0, "y": 208.0, "canvas_w": 255.0, "canvas_h": 30.0, "props": {"text": "", "font": ["Segoe UI", 11], "fg": "#212121", "bg": "#eeeeee", "relief": "solid", "justify": "center", "corner_radius": "", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 7, "parent_tab": null, "elem_id": 2}, {"elem_type": "Entry", "x": 144.0, "y": 168.0, "canvas_w": 152.0, "canvas_h": 30.0, "props": {"textvariable": "", "show": "", "width": 20, "font": ["Segoe UI", 11], "fg": "#212121", "bg": "white", "justify": "left", "default_value": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 3}, {"elem_type": "LEDIndicator", "x": 210.0, "y": 248.0, "canvas_w": 40.0, "canvas_h": 40.0, "props": {"state": "On", "on_color": "#00FF66", "off_color": "#16351F", "shape": "Round", "brightness": 100, "glow": "No", "border_width": 2, "bg": "#F5F5F5", "source_widget": "1", "source_mode": "Toggle", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 5}, {"elem_type": "LabelFrame", "x": 0, "y": 9, "canvas_w": 400.0, "canvas_h": 585.0, "props": {"text": "Login", "bd": 3, "bg": "#F5F5F5", "font": ["Segoe UI", 9], "corner_radius": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": null, "parent_tab": null, "elem_id": 7}, {"elem_type": "LEDDisplay", "x": 50.0, "y": 340, "canvas_w": 172.0, "canvas_h": 40.0, "props": {"value": "", "digits": 4, "color": "#00FF66", "off_color": "#16351F", "brightness": 100, "glow": "Yes", "leading_zeros": "No", "segment_width": 2, "digit_gap": 16, "decimal_places": 0, "bg": "#101010", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 8}, {"elem_type": "LEDDigit", "x": 223.0, "y": 340, "canvas_w": 52.0, "canvas_h": 40.0, "props": {"value": "0", "color": "#ff7979", "off_color": "#16351F", "brightness": 100, "glow": "Yes", "segment_width": 2, "digit_gap": 12, "bg": "#101010", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 10}, {"elem_type": "MeasurementDisplay", "x": 484.0, "y": 178, "canvas_w": 199.0, "canvas_h": 155.0, "props": {"label": "Temperature", "value": "24", "unit": "\u00b0C", "style": "Modern", "color": "#1976D2", "bg": "#ffffff", "decimal_places": 0, "prefix": "", "suffix": "", "secondary_text": "Qatar, Doha", "secondary_color": "#666666", "align": "center", "led_digits": 3, "label_font": ["Bahnschrift", 16], "label_color": "#ff0000", "value_font": ["Mudir MT", 48], "value_color": "#1976D2", "unit_font": ["Segoe UI Semibold", 18], "unit_color": "#000000", "secondary_font": ["Noto Sans Georgian Bold", 16], "secondary_text_color": "#507c73", "unit_gap": 40, "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 12, "parent_tab": null, "elem_id": 9}, {"elem_type": "Combobox", "x": 430.0, "y": 80, "canvas_w": 225.0, "canvas_h": 30.0, "props": {"values": ["Option 1", "Option 2", "Option 3"], "state": "normal", "font": ["Segoe UI Light", 10], "width": 18, "default_value": "", "corner_radius": "", "border_width": 2, "sorted": "Yes", "maxdropdown": 15, "maxlength": 1000, "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 12, "parent_tab": null, "elem_id": 11}, {"elem_type": "Frame", "x": 400.0, "y": 8.0, "canvas_w": 375.0, "canvas_h": 585.0, "props": {"bd": 1, "bg": "#ffffff", "relief": "flat", "corner_radius": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": null, "parent_tab": null, "elem_id": 12}, {"elem_type": "Image", "x": 20.0, "y": 18.0, "canvas_w": 148.0, "canvas_h": 112.0, "props": {"image_path": "resources/plant.jpg", "keep_aspect": 1, "bg": "#F5F5F5", "corner_radius": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 13}, {"elem_type": "Label", "x": 410.0, "y": 13, "canvas_w": 355.0, "canvas_h": 30.0, "props": {"text": "", "font": ["Segoe UI Semibold", 16], "fg": "#ffffff", "bg": "#09a9ff", "relief": "flat", "justify": "center", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 12, "parent_tab": null, "elem_id": 14}, {"elem_type": "PushButton", "x": 180.0, "y": 20.0, "canvas_w": 126.0, "canvas_h": 112.0, "props": {"text": "Push Button", "shape": "Square", "style": "Mechanical", "behavior": "Toggle", "default_state": "Off", "font": ["Segoe UI Semibold", 11], "fg": "#5b5b5b", "bg": "#F5F5F5", "active_bg": "#0D47A1", "border_width": 1, "command": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 15}, {"elem_type": "Button", "x": 654.0, "y": 78, "canvas_w": 100.0, "canvas_h": 34.0, "props": {"text": "Update Cities", "font": ["Segoe UI", 9, "bold"], "fg": "#FFFFFF", "bg": "#1976D2", "command": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 12, "parent_tab": null, "elem_id": 16}, {"elem_type": "Label", "x": 40.0, "y": 168.0, "canvas_w": 95.0, "canvas_h": 30.0, "props": {"text": "Name:", "font": ["Segoe UI", 9], "fg": "#212121", "bg": "#F5F5F5", "relief": "solid", "justify": "left", "corner_radius": "", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 7, "parent_tab": null, "elem_id": 4}, {"elem_type": "Label", "x": 30.0, "y": 440.0, "canvas_w": 255.0, "canvas_h": 30.0, "props": {"text": "", "font": ["Segoe UI", 11], "fg": "#212121", "bg": "#eeeeee", "relief": "solid", "justify": "center", "corner_radius": "", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 7, "parent_tab": null, "elem_id": 6}, {"elem_type": "Entry", "x": 134.0, "y": 400.0, "canvas_w": 152.0, "canvas_h": 30.0, "props": {"textvariable": "", "show": "", "width": 20, "font": ["Segoe UI", 11], "fg": "#212121", "bg": "white", "justify": "left", "default_value": "", "corner_radius": "", "border_width": "", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 7, "parent_tab": null, "elem_id": 17}, {"elem_type": "Label", "x": 30.0, "y": 400.0, "canvas_w": 95.0, "canvas_h": 30.0, "props": {"text": "Enter OTP:", "font": ["Segoe UI", 9], "fg": "#212121", "bg": "#F5F5F5", "relief": "solid", "justify": "left", "corner_radius": "", "border_width": 1, "image_path": "", "image_mode": "Fit", "image_anchor": "Center", "content_anchor": "center", "compound": "none"}, "parent_id": 7, "parent_tab": null, "elem_id": 18}, {"elem_type": "Gauge", "x": 480, "y": 390, "canvas_w": 180.0, "canvas_h": 150.0, "props": {"value": 50, "min_value": 0, "max_value": 100, "start_angle": 225, "end_angle": -45, "needle_color": "#E53935", "arc_color": "#1976D2", "track_color": "#D9D9D9", "tick_color": "#555555", "ticks": 10, "show_value": "Yes", "unit": "", "thickness": 8, "bg": "#FFFFFF", "image_path": "", "image_mode": "Fit", "image_anchor": "Center"}, "parent_id": 12, "parent_tab": null, "elem_id": 19}], "next_id": 21, "reusable_ids": [20], "window_title": "My Application", "canvas_w": 810.0, "canvas_h": 600, "canvas_bg": "#ffffff", "canvas_bg_image": "", "canvas_bg_image_mode": "Fit", "canvas_bg_image_anchor": "Center", "window_state": "Centered", "window_locked": false, "canvas_imports": "import tkinter as tk\nfrom tkinter import ttk", "user_code": "\"\"\"\nMainApplication -- your code.\n\nThis file is yours: the designer never overwrites it. It is only\nscaffolded once, the first time this project gets its first\nelement. New event handler stubs are appended here automatically\nwhen you add an element with an event, but only if a method of\nthat name does not already exist -- existing code is never\ntouched, and nothing is ever removed from this file automatically\n(including when the element itself is later deleted).\n\"\"\"\n\nfrom main_app_designer import _MainApplicationDesigner\nimport random\nfrom time import strftime\nimport urllib.request\nimport json\nimport threading\nimport csv\n\n# Global in-memory cache for loaded city data\n_CITY_DATA_CACHE = None\n_CITY_LIST_CACHE = None\n\n\ndef load_city_data_from_file(csv_path=r\"G:\\Development\\Python Projects\\GuiBuilder\\Apps\\simplemaps_worldcities_basicv1.91.4\\worldcities1000.csv\", force_reload=False):\n    \"\"\"\n    Reads the CSV file ONLY when force_reload=True or on initial uncached load.\n    Otherwise, returns the cached version immediately.\n    \"\"\"\n    global _CITY_DATA_CACHE, _CITY_LIST_CACHE\n\n    # If already cached and no forced reload requested, use cached memory\n    if _CITY_DATA_CACHE is not None and not force_reload:\n        return _CITY_DATA_CACHE, _CITY_LIST_CACHE\n\n    city_map = {}\n    try:\n        with open(csv_path, mode=\"r\", encoding=\"utf-8\") as f:\n            reader = csv.DictReader(f)\n            for row in reader:\n                # Format changed to: Country, City\n                key = f\"{row['country'].strip()}, {row['city'].strip()}\"\n                city_map[key] = {\n                    \"lat\": float(row[\"lat\"]),\n                    \"lng\": float(row[\"lng\"]),\n                    \"iso2\": row.get(\"iso2\", \"\"),\n                }\n    except FileNotFoundError:\n        # Fallback default values if CSV file is missing (Country, City format)\n        city_map[\"Qatar, Doha\"] = {\"lat\": 25.2854, \"lng\": 51.5310, \"iso2\": \"QA\"}\n        city_map[\"United Kingdom, London\"] = {\n            \"lat\": 51.5074,\n            \"lng\": -0.1278,\n            \"iso2\": \"GB\",\n        }\n\n    _CITY_DATA_CACHE = city_map\n    _CITY_LIST_CACHE = sorted(list(city_map.keys()))\n    return _CITY_DATA_CACHE, _CITY_LIST_CACHE\n\n\nclass MainApplication(_MainApplicationDesigner):\n    def __init__(self, root):\n        self.root = root\n        self._build_ui()\n        \n        self.var1 = 0\n        self.myid = None\n        \n        # Initial run: Load data into memory cache (or retrieve existing cache)\n        cities_file_path = r\"G:\\Development\\Python Projects\\GuiBuilder\\Apps\\simplemaps_worldcities_basicv1.91.4\\worldcities1000.csv\"\n        self.city_data, self.city_list = load_city_data_from_file(csv_path=cities_file_path, force_reload=False)\n\n        # Populate Combobox values and setup live filtering listener\n        self._populate_combobox()\n        \n        # Set default selection\n        default_city = \"Qatar, Doha\"\n        if default_city in self.city_data:\n            try:\n                self._elem_11.set(default_city)\n            except AttributeError:\n                pass\n\n        self._update_clock()\n        self._update_weather()\n\n    def _populate_combobox(self):\n        \"\"\"Populates combobox widget from cached memory list and binds keystroke filter.\"\"\"\n        try:\n            self._elem_11['values'] = self.city_list\n            self._elem_11.config(state=\"normal\")\n            self._elem_11.bind('<KeyRelease>', self._on_combobox_keyrelease)\n        except (TypeError, AttributeError):\n            try:\n                self._elem_11.configure(values=self.city_list, state=\"normal\")\n                self._elem_11.bind('<KeyRelease>', self._on_combobox_keyrelease)\n            except AttributeError:\n                pass\n\n    def _on_combobox_keyrelease(self, event):\n        \"\"\"Filters the combobox options dynamically on every keystroke.\"\"\"\n        # Skip search processing for control and arrow navigation keys\n        if event.keysym in ('Up', 'Down', 'Left', 'Right', 'Return', 'Escape', 'Tab', 'Shift_L', 'Shift_R'):\n            return\n\n        typed_text = self._elem_11.get().strip().lower()\n\n        if not typed_text:\n            filtered_cities = self.city_list\n        else:\n            filtered_cities = [\n                city for city in self.city_list\n                if typed_text in city.lower()\n            ]\n\n        # Update combobox values instantly in memory\n        try:\n            self._elem_11['values'] = filtered_cities\n        except (TypeError, AttributeError):\n            try:\n                self._elem_11.configure(values=filtered_cities)\n            except AttributeError:\n                pass\n\n    def _on_update_city_data_button(self, event=None):\n        \"\"\"\n        Handler for \"Update City Data\" button.\n        Forces re-reading the CSV file from disk and refreshing the combobox cache.\n        \"\"\"\n        def reload_task():\n            self.city_data, self.city_list = load_city_data_from_file(force_reload=True)\n            self.root.after(0, self._populate_combobox)\n\n        threading.Thread(target=reload_task, daemon=True).start()\n\n    def _on_Button_1(self, event=None):\n        \"\"\"\n        Event handler for Button (ID: 1).\n        Triggered by: command\n        Access widget instance via: self._elem_1\n        \"\"\"\n        self.myid = random.randint(100, 10000)\n        self.myid_digit = random.randint(1, 10)\n        self.user_name = self._elem_3.get()\n        self._elem_2.configure(text= f\"Welcome {self.user_name}\", bg=\"black\", fg=\"white\")\n        self._elem_8.set_value(self.myid)\n        self._elem_10.set_value(self.myid_digit)\n\n\n    def _on_Entry_3(self, event=None):\n        \"\"\"\n        Event handler for Entry (ID: 3).\n        Triggered by: <KeyRelease>\n        Access widget instance via: self._elem_3\n        \"\"\"\n        pass\n\n    def _on_Button_9(self, event=None):\n        \"\"\"\n        Event handler for Button (ID: 9).\n        Triggered by: command\n        Access widget instance via: self._elem_9\n        \"\"\"\n        pass\n        \n    def _on_Combobox_11(self, event=None):\n        \"\"\"\n        Event handler for Combobox (ID: 11).\n        Triggered by: <<ComboboxSelected>>\n        Access widget instance via: self._elem_11\n        \"\"\"\n        # Restore full city list upon completing selection\n        self._populate_combobox()\n        # Reads coordinates from cached dictionary in memory (O(1) speed)\n        self._update_weather()\n\n    def _update_clock(self):\n        \"\"\"Updates self._elem_14 with the current date and time every second.\"\"\"\n        now = strftime(\"%d-%m-%Y  %H:%M:%S\")\n        self._elem_14.config(text=now)\n        self.root.after(1000, self._update_clock)\n\n    def _update_weather(self):\n        \"\"\"Fetches live weather data in background using cached city coordinates.\"\"\"\n        selected_city = self._elem_11.get() if hasattr(self._elem_11, 'get') else \"Qatar, Doha\"\n        \n        # Read directly from cached dictionary memory\n        coords = self.city_data.get(selected_city)\n        if not coords:\n            coords = self.city_data.get(\"Qatar, Doha\", {\"lat\": 25.2854, \"lng\": 51.5310})\n\n        lat = coords[\"lat\"]\n        lng = coords[\"lng\"]\n\n        def fetch_task():\n            try:\n                url = f\"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lng}&current_weather=true\"\n                req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\n                \n                with urllib.request.urlopen(req, timeout=5) as response:\n                    data = json.loads(response.read().decode())\n                    temp = data['current_weather']['temperature']\n                    \n                    self.root.after(0, lambda: self._apply_weather_data(temp, selected_city))\n            except Exception as e:\n                print(f\"Weather update failed: {e}\")\n                self.root.after(0, lambda: self._apply_weather_data(\"Error\", selected_city))\n\n        threading.Thread(target=fetch_task, daemon=True).start()\n\n    def _apply_weather_data(self, temp, selected_city):\n        \"\"\"Safely updates the custom Tkinter widget with new data.\"\"\"\n        try:\n            self._elem_9.set_value(str(temp))\n            if hasattr(self._elem_9, 'set_secondary_text'):\n                self._elem_9.set_secondary_text(selected_city)\n        except AttributeError:\n            try:\n                self._elem_9.config(text=f\"{temp} \u00b0C\")\n            except AttributeError:\n                print(\"Could not update BuilderMeasurementDisplay: verify the widget's update method.\")\n\n    def _on_PushButton_15(self, event=None):\n        \"\"\"\n        Event handler for PushButton (ID: 15).\n        Triggered by: command\n        Access widget instance via: self._elem_15\n        \"\"\"\n        self.myid = random.randint(100, 10000)\n        self.myid_digit = random.randint(1, 10)\n        self.user_name = self._elem_3.get()\n        self._elem_2.configure(text= f\"Welcome {self.user_name}\", bg=\"black\", fg=\"white\")\n        self._elem_8.set_value(self.myid)\n        self._elem_10.set_value(self.myid_digit)\n\n    def _on_Button_16(self, event=None):\n        \"\"\"\n        Event handler for Button (ID: 16).\n        Triggered by: command\n        Access widget instance via: self._elem_16\n        \"\"\"\n        # Connected to Update City Data logic\n        self._on_update_city_data_button()\n\n\n    def _on_Checkbutton_4(self, event=None):\n        \"\"\"\n        Event handler for Checkbutton (ID: 4).\n        Triggered by: command\n        Access widget instance via: self._elem_4\n        \"\"\"\n        pass\n\n    def _on_Entry_17(self, event=None):\n        \"\"\"\n        Event handler for Entry (ID: 17).\n        Triggered by: <KeyRelease>\n        Access widget instance via: self._elem_17\n        \"\"\"\n        if str(self._elem_17.get()) == str(self.myid):\n            self._elem_6.configure(text=f\"Login Successfull\")\n        else:\n            self._elem_6.configure(text= f\"Wrong OTP\" if len(self._elem_17.get()) == 4 else \"\")\n        \n    def _on_Calendar_20(self, event=None):\n        \"\"\"\n        Event handler for Calendar (ID: 20).\n        Triggered by: <<CalendarSelected>>\n        Access widget instance via: self._elem_20\n        \"\"\"\n        pass\nif __name__ == '__main__':\n    import tkinter as tk\n    root = tk.Tk()\n    app = MainApplication(root)\n    root.mainloop()"}